{
  "name": "@agent-beacon/cloudflare-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "wrangler dev --local",
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --import tsx --test test/*.test.ts forwarder/*.test.mjs",
    "test:e2e": "npm run build && node --import tsx --test test/worker.test.ts",
    "test:collector": "npm run build && node --import tsx --test test/collector.e2e.ts",
    "test:browser": "node --import tsx --test test/dashboard.browser.mjs",
    "test:workflow-browser": "npm run build && node --import tsx --test test/workflow.browser.mjs",
    "test:remote": "node --import tsx scripts/cloud-smoke.ts",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist/deploy",
    "backup:restore-check": "node --import tsx scripts/restore-check.ts",
    "device:prepare": "node scripts/prepare-device.mjs"
  },
  "overrides": {"sharp": "0.35.5"},
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.0",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "22.19.17",
    "esbuild": "0.28.2",
    "miniflare": "5.20261001.0-alpha",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.147.0"
  }
}
